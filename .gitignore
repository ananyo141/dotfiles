# ignore .bak extension files
*.bak
.DS_Store

# (n)vim session files
*.vim

# ignore tmux plugins folder created by tmux
# when directly symlinked
.config/tmux/plugins/

# ignore lunarvim *lock files
.config/lvim/lazy-lock.json
.config/lvim/plugin/packer_compiled.lua

# python cache
__pycache__/
*.py[o,c]
.mypy_cache/

# opencode notifier runtime state
.config/opencode/opencode-notifier-state.json


# credentials / auth state
.config/gh/hosts.yml
.config/github-copilot/
.config/stripe/
.config/configstore/

# runtime state, logs, caches
.config/cagent/
.config/chatter/
.config/herdr/
.config/jgit/
.config/mole/
.config/openchamber/
.config/qBittorrent/

# nested git clone of LazyVim/starter
.config/lazyvim/

# work-internal skills (employee/task IDs, internal endpoints) — public repo
.config/opencode/skills/weekly-timesheet/
.config/opencode/skills/jira-ticket-handling/
