[user]
	name = Ananyobrata Pal
	email = ananyo141@gmail.com
[core]
	editor = vim
	pager = delta
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
	line-numbers = true

[merge]
	conflictStyle = zdiff3
[commit]
	gpgsign = true
[tag]
	gpgsign = true

# machine-specific: signing key/format, delta layout. Not tracked.
[include]
	path = ~/.gitconfig.local
